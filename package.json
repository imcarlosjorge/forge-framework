{
  "private": true,
  "name": "forge-framework",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.29.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint \"apps/**/*.{ts,tsx,js}\" --max-warnings=0",
    "lint:css": "stylelint \"apps/**/*.{css,scss}\" --allow-empty-input"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "stylelint": "^17.1.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.54.0"
  }
}
