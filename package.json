{
  "private": true,
  "name": "forge-framework",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.29.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel --filter=!cli",
    "dev:web": "turbo run dev --parallel --filter=frontend",
    "dev:api": "turbo run dev --parallel --filter=backend",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:js": "eslint \"apps/**/*.{ts,tsx,js}\" --max-warnings=0",
    "lint:css": "stylelint \"apps/**/*.{css,scss}\" --allow-empty-input"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^2.8.12",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  },
  "pnpm": {
    "overrides": {
      "eslint": "^9.39.2",
      "eslint-plugin-import": "^2.29.1"
    }
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
